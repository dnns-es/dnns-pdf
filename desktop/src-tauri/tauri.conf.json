{
    "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "DNNS PDF",
    "version": "0.3.0",
    "identifier": "es.dnns.pdf",
    "build": {
        "frontendDist": "../../dist",
        "devUrl": "http://localhost:5174/",
        "beforeDevCommand": "npm run dev --prefix .. -- --port 5174 --strictPort",
        "beforeBuildCommand": "npm run build --prefix .."
    },
    "app": {
        "windows": [
            {
                "title": "DNNS PDF",
                "width": 1200,
                "height": 820,
                "minWidth": 480,
                "minHeight": 400,
                "resizable": true,
                "dragDropEnabled": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "plugins": {
        "updater": {
            "endpoints": ["https://github.com/dnns-es/dnns-pdf/releases/latest/download/latest.json"],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNjkzNkUxNTgyRTU0NTAKUldSUVZDNVk0VFpwZ3BDU2orMW50OVkrcTJsYUNXb1IyazRtK3prVWFYWjJUZnA5cnJLQ3pmemsK"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "createUpdaterArtifacts": true,
        "publisher": "DNNS.es",
        "copyright": "AGPL-3.0 · DNNS.es",
        "category": "Productivity",
        "shortDescription": "Editor de PDF libre y gratuito",
        "longDescription": "Editor de PDF libre y gratuito. Todo se procesa en tu equipo: los documentos nunca se suben a ningún servidor.",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ],
        "fileAssociations": [
            {
                "ext": ["pdf"],
                "mimeType": "application/pdf",
                "name": "Documento PDF",
                "description": "Documento PDF",
                "role": "Viewer"
            }
        ],
        "windows": {
            "webviewInstallMode": { "type": "downloadBootstrapper" },
            "nsis": {
                "installMode": "currentUser",
                "languages": ["Spanish", "English"],
                "displayLanguageSelector": false,
                "startMenuFolder": "DNNS PDF"
            }
        }
    }
}
